{
  "name": "@local/dsh-comfy-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Comfy 实时台：把 ComfyUI 的执行过程变成 DSH 里的实时面板（节点逐个点亮、进度、实时预览、工作流可回看）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
