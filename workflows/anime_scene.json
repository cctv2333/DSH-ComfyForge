      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": ""
      }
    },
    "5": {
      "class_type": "FluxGuidance",
      "inputs": {
        "conditioning": [
          "4",
          0
        ],
        "guidance": 3.5
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "2",
          0
        ],
        "text": ""
